        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.neighbors import KNeighborsClassifier\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "df = pd.read_excel('var1.xlsx')\n",
        "\n",
        "print(\"Primeras filas del dataset:\")\n",
        "print(df.head())\n",
        "\n",
        "X = df[['Ingreso_Mensual', 'Numero_Hijos']].values\n",
        "y = df['Tipo_Vivienda'].values\n",
        "\n",
        "knn = KNeighborsClassifier(n_neighbors=3)\n",
        "knn.fit(X, y)\n",
        "\n",
        "nuevo_punto = np.array([[45000, 3]])\n",
        "prediccion = knn.predict(nuevo_punto)\n",
        "\n",
        "print(f\"La predicción para el tipo de vivienda es: {prediccion[0]}\")\n",
        "\n",
        "plt.scatter(X[:, 0], X[:, 1], c=y, cmap='coolwarm', label='Datos Históricos')\n",
        "plt.scatter(nuevo_punto[:, 0], nuevo_punto[:, 1], c='black', label=\"Nuevo cliente\", marker='X', s=100)\n",
        "\n",
        "plt.title(\"Clasificación KNN: Tipo de Vivienda\")\n",
        "plt.xlabel(\"Ingreso Mensual ($)\")\n",
        "plt.ylabel(\"Número de Hijos\")\n",
        "plt.legend()\n",
        "plt.show()"
      ]
